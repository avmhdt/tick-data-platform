# ---------- required ----------
# required. Password of the local ClickHouse user 'tickdb'. Never commit.
CLICKHOUSE_PASSWORD=
# required. Local Grafana admin password. Never commit.
GRAFANA_ADMIN_PASSWORD=
# required. Data root inside the WSL2 ext4 filesystem, never /mnt/*. Write it absolute in .env (/home/USER/data/tick-data-platform): docker compose does not expand ~.
DATA_ROOT=~/data/tick-data-platform
# optional. Holds raw/, interim/, archive datasets, clickhouse/, prometheus/, grafana/; empty = DATA_ROOT.
TICKDB_DATA_DIR=
# ---------- optional (defaults shown) ----------
# optional. Main YAML config path.
TICKDB_CONFIG=config/tickdb.yaml
# optional. DEBUG|INFO|WARNING|ERROR.
TICKDB_LOG_LEVEL=INFO
# optional. JSON logs for long-running services.
TICKDB_LOG_JSON=true
# optional. Use 'clickhouse' inside the compose network.
CLICKHOUSE_HOST=localhost
# optional. Bound to 127.0.0.1 only.
CLICKHOUSE_HTTP_PORT=8123
# optional. Read-write user for loaders.
CLICKHOUSE_USER=tickdb
# optional. Read-only user used by the client and Grafana.
CLICKHOUSE_READONLY_USER=tickdb_ro
# optional. Required only if the read-only user is enabled (default enabled in M4).
CLICKHOUSE_READONLY_PASSWORD=
# optional. Bound to 127.0.0.1.
PROMETHEUS_PORT=9090
# optional. Bound to 127.0.0.1.
GRAFANA_PORT=3000
# optional. Ingestor i exposes /metrics on base+i.
TICKDB_METRICS_PORT_BASE=9101
# optional. Clock-offset probe target.
NTP_SERVER=pool.ntp.org
# optional. itch-feed-handler canonical Parquet output (M6).
TICKDB_ITCH_CANONICAL_DIR=
# ---------- optional, gated by Decisions ----------
# optional. Only if Coinbase market data requires auth (P-09). View-only key.
COINBASE_API_KEY=
# optional. Pair of COINBASE_API_KEY.
COINBASE_API_SECRET=
# optional, PAID. Use only after D-04 approval.
DATABENTO_API_KEY=
# optional. Hard cost cap enforced by the importer; 0 disables Databento.
TICKDB_DATABENTO_BUDGET_USD=0
# optional. Directory holding the kdb+ licence file (D-07).
QLIC=
