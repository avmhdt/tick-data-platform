      "id": 8,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.23.4",
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(date) + toIntervalHour(hour) AS time, concat(venue, ' ', dataset, ' p99') AS series, max(p99_ms) AS value FROM tickdb.dq_latency FINAL WHERE $__dateFilter(date) AND venue IN (${venue:singlequote}) AND n > 0 GROUP BY time, series ORDER BY time",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "pluginVersion": "4.23.4",
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(date) + toIntervalHour(hour) AS time, concat(venue, ' ', dataset, ' p50') AS series, max(p50_ms) AS value FROM tickdb.dq_latency FINAL WHERE $__dateFilter(date) AND venue IN (${venue:singlequote}) AND n > 0 GROUP BY time, series ORDER BY time",
          "refId": "B"
        }
      ],
      "title": "Feed latency p50 / p99 per hour (daily DQ)",
      "type": "timeseries"
